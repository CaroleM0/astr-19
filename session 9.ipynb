   ],
   "source": [
    "random_numbers = np.random.uniform(0, 1, 1000)\n",
    "\n",
    "plt.figure()\n",
    "plt.hist(random_numbers, bins=100)\n",
    "plt.xlabel(\"Random Number Value\")\n",
    "plt.ylabel(\"Count\")\n",
    "\n",
    "plt.savefig(\"uniform_histogram.pdf\")\n",
    "plt.show()"
   ]
